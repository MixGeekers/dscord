# Set the Matrix identity domain before the first start. It is persisted.
DS_GROUP_SERVER_NAME=localhost
DS_GROUP_PUBLIC_URL=http://localhost:18100
DS_GROUP_MATRIX_PUBLIC_URL=http://localhost:18008
# Accounts come from this central server. The bundled one listens on 18200; set another URL to share its accounts.
DS_GROUP_CENTRAL_URL=http://localhost:18200
DSCORD_CENTRAL_REGISTRATION=open
DS_GROUP_BIND=127.0.0.1
DS_GROUP_HTTP_PORT=18100
DS_GROUP_MATRIX_PORT=18008

# Independent chat client hosting: persist api-only in the Core configuration.
# Leave unset to retain the stored mode (fresh/legacy default: bundled).
# DS_GROUP_WEB_MODE=api-only

# For compose.https.yaml, set all three URLs to your HTTPS domain.
# DS_GROUP_DOMAIN=chat.example.com
# DS_GROUP_SERVER_NAME=chat.example.com
# DS_GROUP_PUBLIC_URL=https://chat.example.com
# DS_GROUP_MATRIX_PUBLIC_URL=https://chat.example.com
# The bundled central server on its own HTTPS hostname:
# DS_GROUP_CENTRAL_DOMAIN=id.example.com
# DS_GROUP_CENTRAL_URL=https://id.example.com

# A tagged release image can replace local builds after it is published.
# DS_GROUP_IMAGE=ghcr.io/mixgeekers/ds-group:0.1.0
