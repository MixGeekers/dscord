{
  "name": "ds-group",
  "version": "0.4.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Human and independent Bot collaboration over Matrix and DS-Bot",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs && npm run build:admin",
    "build:admin": "tsc -p admin/tsconfig.json --noEmit && vite build --config admin/vite.config.ts && node admin/build.mjs && vite build --config admin/central/vite.config.ts && node admin/central/build.mjs",
    "admin:init": "node scripts/admin.mjs init",
    "admin:start": "node src/admin.mjs",
    "preup": "npm run build",
    "up": "node scripts/service.mjs up",
    "down": "node scripts/service.mjs down",
    "status": "node scripts/service.mjs status",
    "matrix": "node scripts/matrix.mjs",
    "start": "node src/core.mjs",
    "central": "node central/service.mjs",
    "node": "node src/bot-node.mjs",
    "dsh": "node scripts/dsh-node.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=memory/** --test-coverage-include=dsh-connect/** --test-coverage-include=dsh-plugin/** tests/*.test.mjs",
    "test:kernel-host": "node --import ./tests/kernel-peer-resolution.mjs --test tests/kernel-native.host.mjs tests/kernel-local-agent.host.mjs tests/memory-tools-schema.host.mjs tests/memory-claimed-context.host.mjs tests/memory-snapshot.host.mjs tests/memory-stream-accounting.host.mjs tests/model-profile.host.mjs tests/work-core-tools.host.mjs",
    "runtime:memory-snapshot-check": "node tests/memory-snapshot.runtime.mjs",
    "runtime:native-check": "node tests/runtime-native.host.mjs",
    "check": "node scripts/check.mjs",
    "lint": "oxlint",
    "format": "prettier --write \"web/src/**/*.{ts,tsx}\" \"admin/src/**/*.{ts,tsx}\" \"admin/central/src/**/*.{ts,tsx}\" \"ui/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"web/src/**/*.{ts,tsx}\" \"admin/src/**/*.{ts,tsx}\" \"admin/central/src/**/*.{ts,tsx}\" \"ui/**/*.{ts,tsx}\"",
    "verify": "node scripts/verify.mjs",
    "deploy:check": "node scripts/deploy-smoke.mjs",
    "runtime:check": "node scripts/runtime-smoke.mjs",
    "runtime:work-check": "node scripts/runtime-work-smoke.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "verify:work": "node scripts/verify-file-work.mjs --run",
    "release:pack": "node scripts/release-pack.mjs",
    "npm:pack": "npm run build && node scripts/npm-pack.mjs",
    "npm:smoke": "node scripts/npm-smoke.mjs",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/client": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "deep-view": "0.1.2",
    "highlight.js": "11.12.0",
    "imapflow": "2.9.1",
    "lucide": "1.68.0",
    "lucide-react": "1.68.0",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "Apache-2.0"
}
